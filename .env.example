# Обязательно: токен НОВОГО бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Необязательные настройки (показаны значения по умолчанию)
# MIN_PLAYERS=4
# MAX_PLAYERS=20
# REGISTRATION_TIME=120     # набор игроков, сек
# NIGHT_TIME=60
# DAY_TIME=45               # обсуждение днём (+ DAY_TIME_PER_PLAYER за каждого живого)
# DAY_TIME_PER_PLAYER=5
# VOTE_TIME=45
# CONFIRM_TIME=30           # «вешаем или нет»
# LAST_WORDS_TIME=45
# AFK_LIMIT=2               # выбывает, пропустив столько голосований подряд (0 = выкл)
# MAX_IDLE_ROUNDS=3         # ничья, если столько кругов подряд никто не умер
# REVEAL_ROLES=true         # показывать роль погибшего
# DELETE_MESSAGES=true      # мёртвые и ночь молчат (нужны права админа)
# DB_PATH=mafia.db
# WEB_SERVER_ENABLED=true   # health-сервер для Render
